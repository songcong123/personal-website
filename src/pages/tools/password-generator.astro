---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`密码生成器 | ${SITE_TITLE}`}
			description="在线生成强随机密码，支持自定义长度与字符集，纯浏览器本地运行"
		/>
		<style>
			main {
				width: 720px;
			}
			h1 {
				margin: 1.5em 0 0.5em;
			}
			.hint {
				color: rgb(var(--gray));
				margin-bottom: 1.5em;
			}
			.output {
				display: flex;
				gap: 0.5em;
				align-items: center;
			}
			#password {
				flex: 1;
				padding: 0.9em 1em;
				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
				font-size: 18px;
				letter-spacing: 1px;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgb(var(--gray-light) / 30%);
				word-break: break-all;
				min-height: 1.6em;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				margin: 1em 0 2em;
			}
			button {
				padding: 0.5em 1.2em;
				border: 1px solid var(--accent);
				border-radius: 6px;
				background: white;
				color: var(--accent);
				font-size: 0.95em;
				cursor: pointer;
				transition: 0.15s ease;
			}
			button:hover {
				background: var(--accent);
				color: white;
			}
			button.primary {
				background: var(--accent);
				color: white;
			}
			button.primary:hover {
				background: var(--accent-dark);
			}
			.options {
				display: grid;
				gap: 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5em;
			}
			.length-row {
				display: flex;
				align-items: center;
				gap: 1em;
			}
			.length-row label {
				white-space: nowrap;
			}
			#length {
				flex: 1;
				accent-color: var(--accent);
			}
			#length-value {
				font-weight: 700;
				min-width: 2em;
				text-align: center;
			}
			.checks {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
				gap: 0.5em 1em;
			}
			.checks label {
				display: flex;
				align-items: center;
				gap: 0.4em;
				cursor: pointer;
			}
			.checks input {
				accent-color: var(--accent);
				width: 1.05em;
				height: 1.05em;
			}
			.strength {
				margin-top: 1.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.strength-bar {
				height: 6px;
				border-radius: 3px;
				background: rgb(var(--gray-light));
				overflow: hidden;
				margin-top: 0.4em;
			}
			.strength-bar-fill {
				height: 100%;
				width: 0;
				border-radius: 3px;
				background: var(--accent);
				transition: 0.3s ease;
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>🔐 密码生成器</h1>
			<p class="hint">使用浏览器密码学随机源（crypto.getRandomValues）生成，全程本地运行，不会上传。</p>

			<div class="output">
				<div id="password"></div>
			</div>

			<div class="actions">
				<button id="generate" class="primary">重新生成</button>
				<button id="copy">复制密码</button>
			</div>

			<div class="options">
				<div class="length-row">
					<label for="length">长度</label>
					<input type="range" id="length" min="6" max="64" value="16" />
					<span id="length-value">16</span>
				</div>
				<div class="checks">
					<label><input type="checkbox" id="upper" checked /> 大写字母 A-Z</label>
					<label><input type="checkbox" id="lower" checked /> 小写字母 a-z</label>
					<label><input type="checkbox" id="digits" checked /> 数字 0-9</label>
					<label><input type="checkbox" id="symbols" checked /> 符号 !@#$…</label>
					<label><input type="checkbox" id="exclude-ambiguous" /> 排除易混淆字符 0O1lI|</label>
				</div>
			</div>

			<div class="strength">
				强度：<span id="strength-label">-</span>
				<div class="strength-bar"><div class="strength-bar-fill" id="strength-fill"></div></div>
			</div>
		</main>
		<Footer />

		<script>
			const el = {
				password: document.getElementById('password')!,
				generate: document.getElementById('generate')!,
				copy: document.getElementById('copy')!,
				length: document.getElementById('length') as HTMLInputElement,
				lengthValue: document.getElementById('length-value')!,
				upper: document.getElementById('upper') as HTMLInputElement,
				lower: document.getElementById('lower') as HTMLInputElement,
				digits: document.getElementById('digits') as HTMLInputElement,
				symbols: document.getElementById('symbols') as HTMLInputElement,
				excludeAmbiguous: document.getElementById('exclude-ambiguous') as HTMLInputElement,
				strengthLabel: document.getElementById('strength-label')!,
				strengthFill: document.getElementById('strength-fill')!,
			};

			const SETS = {
				upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
				lower: 'abcdefghijklmnopqrstuvwxyz',
				digits: '0123456789',
				symbols: '!@#$%^&*()-_=+[]{};:,.<>?',
			};
			const AMBIGUOUS = new Set('0O1lI|');

			function pool(): { chars: string; sets: number } {
				let chars = '';
				let sets = 0;
				for (const [key, checked] of Object.entries({
					upper: el.upper.checked,
					lower: el.lower.checked,
					digits: el.digits.checked,
					symbols: el.symbols.checked,
				})) {
					if (checked) {
						chars += SETS[key as keyof typeof SETS];
						sets++;
					}
				}
				if (el.excludeAmbiguous.checked) {
					chars = [...chars].filter((c) => !AMBIGUOUS.has(c)).join('');
				}
				return { chars, sets };
			}

			// 从字符池里均匀取一个字符（拒绝采样避免取模偏差）
			function pick(chars: string): string {
				const max = 256 - (256 % chars.length);
				const buf = new Uint8Array(1);
				let n: number;
				do {
					crypto.getRandomValues(buf);
					n = buf[0]!;
				} while (n >= max);
				return chars[n % chars.length]!;
			}

			function generate() {
				const { chars, sets } = pool();
				if (!chars) {
					el.password.textContent = '⚠️ 请至少勾选一种字符集';
					el.strengthLabel.textContent = '-';
					el.strengthFill.style.width = '0';
					return;
				}
				const len = Number(el.length.value);
				let result = '';
				for (let i = 0; i < len; i++) result += pick(chars);

				el.password.textContent = result;

				// 熵 = len * log2(字符集大小)；保证每类至少出现一次可视为小幅加成，这里按基础熵估算
				const entropy = len * Math.log2(chars.length);
				const levels = [
					{ min: 0, label: '很弱', pct: 15, color: '#dc2626' },
					{ min: 40, label: '弱', pct: 35, color: '#f97316' },
					{ min: 60, label: '中等', pct: 60, color: '#eab308' },
					{ min: 80, label: '强', pct: 82, color: '#16a34a' },
					{ min: 110, label: '很强', pct: 100, color: '#15803d' },
				];
				const level = [...levels].reverse().find((l) => entropy >= l.min)!;
				el.strengthLabel.textContent = `${level.label}（约 ${Math.round(entropy)} 位熵，${sets} 类字符）`;
				el.strengthFill.style.width = `${level.pct}%`;
				el.strengthFill.style.background = level.color;
			}

			el.generate.addEventListener('click', generate);
			el.length.addEventListener('input', () => {
				el.lengthValue.textContent = el.length.value;
				generate();
			});
			for (const box of [el.upper, el.lower, el.digits, el.symbols, el.excludeAmbiguous]) {
				box.addEventListener('change', generate);
			}
			el.copy.addEventListener('click', async () => {
				const text = el.password.textContent ?? '';
				if (!text || text.startsWith('⚠️')) return;
				try {
					await navigator.clipboard.writeText(text);
					el.copy.textContent = '✓ 已复制';
					setTimeout(() => (el.copy.textContent = '复制密码'), 1500);
				} catch {
					// 剪贴板 API 不可用时退回选中提示
					alert('复制失败，请手动选中复制');
				}
			});

			generate();
		</script>
	</body>
</html>
