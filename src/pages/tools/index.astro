---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const tools = [
	{
		href: '/tools/json-formatter/',
		icon: '🧾',
		title: 'JSON 格式化',
		description: '格式化、压缩、校验 JSON 数据，错误信息带行号定位。',
	},
	{
		href: '/tools/password-generator/',
		icon: '🔐',
		title: '密码生成器',
		description: '自定义长度和字符集，使用浏览器密码学随机源生成强密码。',
	},
	{
		href: '/tools/timestamp/',
		icon: '🕒',
		title: '时间戳转换',
		description: 'Unix 时间戳与日期时间互转，支持秒/毫秒、UTC、ISO 8601、相对时间。',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`工具箱 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			h1 {
				text-align: center;
				margin: 1.5em 0;
			}
			.intro {
				text-align: center;
				color: rgb(var(--gray-dark));
				margin-bottom: 2.5em;
			}
			.tool-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
			}
			.tool-grid a {
				display: block;
				padding: 1.5em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				text-decoration: none;
				color: rgb(var(--black));
				transition: 0.2s ease;
			}
			.tool-grid a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			.tool-icon {
				font-size: 2em;
				margin-bottom: 0.5em;
			}
			.tool-title {
				font-weight: 700;
				font-size: 1.2em;
				margin-bottom: 0.5em;
			}
			.tool-desc {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>工具箱</h1>
			<p class="intro">所有工具都在你的浏览器本地运行，数据不会上传到任何服务器。</p>
			<div class="tool-grid">
				{
					tools.map((tool) => (
						<a href={tool.href}>
							<div class="tool-icon">{tool.icon}</div>
							<div class="tool-title">{tool.title}</div>
							<div class="tool-desc">{tool.description}</div>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
